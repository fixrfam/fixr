{
  "name": "@fixr/i18n",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsc --watch",
    "test": "vitest",
    "build": "biome check && tsc",
    "lint": "biome check",
    "lint:write": "biome check --write",
    "check-types": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react.tsx",
      "default": "./src/react.tsx"
    },
    "./locales": {
      "types": "./src/locales/index.ts",
      "default": "./src/locales/index.ts"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@fixr/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@fixr/constants": "workspace:*",
    "i18next": "^25.6.2"
  },
  "peerDependencies": {
    "react": "catalog:"
  }
}
