{
  "name": "@fixr/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "db:push": "bunx --bun drizzle-kit push",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:studio": "bunx --bun drizzle-kit studio",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed/index.ts",
    "check-types": "tsc --noEmit"
  },
  "exports": {
    "./connection": {
      "types": "./src/connection.ts",
      "default": "./src/connection.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@fixr/env": "workspace:*",
    "@fixr/typescript-config": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "catalog:",
    "@types/eslint": "^8.56.5",
    "drizzle-kit": "^0.31.0",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "bcryptjs": "^2.4.3",
    "chalk": "^5.6.2",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "catalog:",
    "mysql2": "catalog:",
    "zod": "catalog:"
  }
}
