# Single env file for local development, shared by every app and package.
# `bun run setup` copies this to `.env` and generates the secrets below.
# Production values are not read from here: CI and Coolify inject them.

# ─── Database (MySQL, started by `bun run db:start`) ──────────────────────────
MYSQL_ROOT_PASSWORD='fixr'
MYSQL_DATABASE='fixr'
MYSQL_USER='docker'
MYSQL_PASSWORD='docker'
DB_URL='mysql://docker:docker@localhost:3306/fixr'

# ─── Redis (cache + background jobs) ──────────────────────────────────────────
REDIS_PASSWORD='docker'
REDIS_URL='redis://default:docker@localhost:6379/0'

# ─── API (apps/server) ────────────────────────────────────────────────────────
NODE_PORT=3333
FRONTEND_URL='http://localhost:3000'
ADMIN_URL='http://localhost:6969'
COOKIE_DOMAIN='localhost'

# Min. 32 chars each. `bun run setup` fills these in for you.
JWT_SECRET=''
API_KEY_SECRET=''
COOKIE_ENCRYPTION_SECRET=''

# ─── Web (apps/web) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL='http://localhost:3333'
NEXT_PUBLIC_APP_URL='http://localhost:3000'
NEXT_PUBLIC_DOCS_URL='https://docs.fixr.com.br'
NEXT_PUBLIC_LINKTREE_URL='http://linktr.ee/fixrfam'

# ─── Cloudflare Turnstile (always-pass test keys) ─────────────────────────────
# Real keys: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY='1x00000000000000000000AA'
TURNSTILE_SECRET_KEY='1x0000000000000000000000000000000AA'

# ─── Mail (Resend) ────────────────────────────────────────────────────────────
# Get this on https://resend.com/api-keys
RESEND_KEY='re_{$}'

# ─── Clerk (apps/admin + admin endpoints in the API) ──────────────────────────
# The placeholder secret lets the API boot. apps/admin needs real keys:
# https://dashboard.clerk.com/apps/{app_id}/instances/{instance_id}/api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=''
CLERK_SECRET_KEY='sk_test_replace_me'

# ─── Google OAuth (placeholders: replace to enable Google sign-in) ────────────
GOOGLE_AUTH_CLIENT_ID='replace-me'
GOOGLE_AUTH_CLIENT_SECRET='replace-me'
GOOGLE_AUTH_REDIRECT_URI='http://localhost:3333/auth/google/callback'

# ─── Cloudflare R2 (placeholders: replace to enable uploads) ──────────────────
CLOUDFLARE_API_TOKEN=''
R2_ACCESS_KEY_ID='replace-me'
R2_SECRET_ACCESS_KEY='replace-me'
R2_BUCKET_URL='https://replace-me.r2.cloudflarestorage.com/fixr'
R2_REGION='auto'
R2_PUBLIC_BASE_URL='https://replace-me.r2.dev'
R2_PRESIGN_EXPIRES_IN='600'
