#!/bin/sh
set -e

echo "Running lint..."
# lint:ci skips the TTY-only --elide-lines flag, so the hook also works in non-interactive shells.
bun run lint:ci

echo "Running type checks..."
bun run check-types:ci

echo "Formatting..."
bun run format

if ! git diff --quiet; then
  echo ""
  echo "Formatter made changes. Committing them now..."
  git add -A
  git commit -m "chore(Repo): Run formatter"
  echo ""
  echo "A new commit with formatting fixes was created locally."
  echo "Push again to include it."
  exit 1
fi

echo "All checks passed!"
exit 0
